NODE_ENV=development
PORT=5092
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/perfume-store
MONGODB_DB_NAME=perfume-store

# JWT / Security Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_at_least_20_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_MS=2592000000

# White-Label Domain Routing & CORS Setup (Comma-separated lists)
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8005,http://localhost:3000
FRONTEND_DOMAIN_KEYWORDS=localhost,decantrebd.com
DASHBOARD_DOMAIN_KEYWORDS=dashboard,localhost:8005

# Outgoing Mail (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=SSL
SMTP_USER=contact@caresbangladesh.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME="Cares Bangladesh"
SMTP_FROM=contact@caresbangladesh.com

# Incoming Mail / Dashboard Inbox Sync (Hostinger IMAP)
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@caresbangladesh.com
IMAP_PASSWORD=your_imap_password
IMAP_SYNC_ENABLED=true

# Cloudflare R2 Cloud Backup & Differential Uploads Sync
R2_ACCOUNT_ID=281a52daaecb2b7942ad2d20a15fa260
R2_ACCESS_KEY_ID=341a9df898444ecf9afd3ba37bf5e4f4
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cares-bangladesh-backup
R2_PUBLIC_URL=
R2_SYNC_ENABLED=true
R2_SYNC_INTERVAL_DAYS=1
